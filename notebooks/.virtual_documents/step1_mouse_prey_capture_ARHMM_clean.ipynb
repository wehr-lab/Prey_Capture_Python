# get num params in model
def get_num_model_params(K=num_states,D=obs_dim,cov="diag"):
    if cov=="diag":
        S = (K+1)*(K-1) + K*(D**2 + 2*D)
    elif cov=="full":
        S = (K+1)*(K-1) + (3/2)*K*(D**2 + D)
    return(int(S))

